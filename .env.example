# Model keys: at least one is required; Groq is preferred when present (free key at console.groq.com).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Extra Groq keys from other organizations; Build mode and the IDE agent round-robin across all of them.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
# GROQ_API_KEYS=key_org1,key_org2,key_org3

# Agent model per provider; GITCLAW_MODEL forces one model for every turn.
# AGENT_MODEL_GROQ=groq:openai/gpt-oss-120b
# AGENT_MODEL_ANTHROPIC=anthropic:claude-sonnet-4-5
# AGENT_MODEL_OPENAI=openai:gpt-4.1
# AGENT_MODEL_GEMINI=google:gemini-2.0-flash
# GITCLAW_MODEL=

# Max tokens per agent reply; keeps a turn under Groq's free-tier tokens-per-minute limit.
# AGENT_MAX_OUTPUT_TOKENS=3000

# Knowledge builder: its own key (defaults to the last Groq key), how much repo it reads, output size and retries.
# GROQ_KNOWLEDGE_API_KEY=
# KNOWLEDGE_INPUT_CHARS=24000
# KNOWLEDGE_MAX_OUTPUT_TOKENS=2500
# KNOWLEDGE_RETRIES=2

# Groq rate tuning: per-key tokens per minute, share of it used, and output cap per generation chunk.
# GROQ_TPM=12000
# GROQ_TPM_HEADROOM=0.85
# GROQ_GEN_MAX_TOKENS=6000

# Public mode: needs a login (beta code or OAuth), MONARCH_SESSION_SECRET and MONARCH_PREVIEW_DOMAIN; leave unset locally.
# MONARCH_PUBLIC_ORIGIN=https://monarch.example.com
# MONARCH_PREVIEW_DOMAIN=monarch.example.com
# MONARCH_BETA_CODE=the-shared-code-you-give-testers

# Google OAuth; callback URL is <origin>/auth/oauth/google/callback.
# MONARCH_GOOGLE_CLIENT_ID=
# MONARCH_GOOGLE_CLIENT_SECRET=
# GitHub OAuth; callback URL is <origin>/auth/oauth/github/callback.
# MONARCH_GITHUB_CLIENT_ID=
# MONARCH_GITHUB_CLIENT_SECRET=
# A GitHub account you own, invited with push access to repos Monarch publishes, and its classic repo-scope token.
# MONARCH_GITHUB_COLLABORATOR=monarch
# MONARCH_GITHUB_COLLABORATOR_TOKEN=
# Who may sign in: emails, @domains or gh:<login>; empty lets anyone in.
# MONARCH_OAUTH_ALLOW=you@example.com,@yourcompany.com,gh:octocat
# At least 32 characters (openssl rand -hex 32); changing it signs everyone out.
# MONARCH_SESSION_SECRET=

# Server and agent service; MONARCH_INTERNAL_TOKEN is only needed when the agent runs separately (MONARCH_SPAWN_AGENT=0).
# MONARCH_LISTEN_ADDR=127.0.0.1:9000
# AGENT_PORT=8001
# MONARCH_SPAWN_AGENT=1
# MONARCH_INTERNAL_TOKEN=

# Sandbox workdirs and saved data (data defaults to ~/.monarch).
# MONARCH_WORK_DIR=/var/lib/monarch/work
# MONARCH_DATA_DIR=/var/lib/monarch/data

# MongoDB; when set it holds users, projects, keys, agents and workflows (local files are imported once).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=monarch_dev

# Limits: sandboxes overall and per user, idle and max lifetime, model calls per hour, free disk and sandbox disk.
# MONARCH_MAX_SANDBOXES=6
# MONARCH_MAX_PER_USER=1
# MONARCH_SANDBOX_IDLE_TTL=15m
# MONARCH_SANDBOX_MAX_TTL=45m
# MONARCH_LLM_PER_HOUR=60
# MONARCH_MIN_FREE_DISK_MB=5120
# MONARCH_SANDBOX_MAX_DISK_MB=3072

# Container engine (docker or podman; for podman also set DOCKER_HOST to its socket) and images built at startup.
# MONARCH_CONTAINER_CLI=podman
# DOCKER_HOST=unix:///run/user/<uid>/podman/podman.sock
# MONARCH_PREHEAT_IMAGES=node,react,python,builder

# No domain: give each preview a free Cloudflare quick tunnel (needs cloudflared).
# MONARCH_PREVIEW_MODE=quicktunnel
# MONARCH_CLOUDFLARED=/usr/local/bin/cloudflared
